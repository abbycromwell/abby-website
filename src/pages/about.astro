---
import Base from '../layouts/Base.astro';
---

<Base
  title="About — Abby Cromwell"
  description="Abby Cromwell is an illustrator, character designer, and storyteller studying Design Media Arts at UCLA. Contact, availability, and resume."
  activePage="about"
  atmospheric
>
  <div class="about-page">
    <section class="about" aria-labelledby="about-title">
      <p class="eyebrow">About</p>
      <h1 id="about-title">Abby Cromwell</h1>
      <div class="about__copy">
        <p>
          I'm an illustrator, character designer, and storyteller interested in
          entertainment worlds and game design.
        </p>
        <p>
          I'm a sophomore in Design Media Arts at UCLA.
        </p>
      </div>
      <div class="about__contact">
        <div>
          <h2 class="eyebrow">Contact</h2>
          <p><a href="mailto:abbycromwell@ucla.edu">abbycromwell at ucla dot edu</a></p>
        </div>
        <div>
          <h2 class="eyebrow">Availability</h2>
          <p>Not taking new projects</p>
        </div>
        <div>
          <h2 class="eyebrow">Resume</h2>
          <a href="/resume/">View the resume</a>
        </div>
        <div>
          <h2 class="eyebrow">Work</h2>
          <a href="/work/">View the work</a>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .about {
    max-width: var(--max-width-wide);
    margin-inline: auto;
    padding: var(--space-page-top) var(--space-edge) var(--space-section);
  }

  h1 {
    margin-bottom: var(--space-xl);
    font-size: var(--text-display);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
  }

  .about__copy,
  .about__contact {
    display: grid;
    gap: var(--space-xl);
    color: var(--color-text-secondary);
  }

  .about__copy {
    max-width: var(--max-width-prose);
    font-size: var(--text-xl);
    line-height: var(--leading-tight);
  }

  .about__copy p,
  .about__contact p {
    margin-bottom: 0;
  }

  .about__contact {
    max-width: var(--max-width-copy);
    margin-top: var(--space-section);
    padding: var(--space-lg);
    background: var(--color-paper-overlay);
  }

  .about__contact a {
    border-bottom: var(--border-thin) solid currentColor;
  }

  @media (min-width: 48rem) {
    .about__contact {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
