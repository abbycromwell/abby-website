---
import Base from '../layouts/Base.astro';
---

<Base
  title="About — Abby Cromwell"
  description="Abby Cromwell is an illustrator, character designer, and storyteller studying Design Media Arts at UCLA. Contact, availability, and resume."
  activePage="about"
  atmospheric
  ground="field"
>
  <div class="about-page">
    <section class="about" aria-labelledby="about-title">
      <div class="about__main">
        <p class="eyebrow">About</p>
        <h1 id="about-title">Abby Cromwell</h1>
        <div class="about__copy">
          <p>
            Hi, I’m Abby. I’m a designer and illustrator who loves creating
            whimsical worlds that connect reality and imagination.
          </p>
          <p>
            I’m currently a UCLA sophomore, majoring in Design Media Arts
            with a minor in Film, Television and Digital Media.
          </p>
        </div>
      </div>

      {/* the SongBook essay's detail rows, so the interior pages read as kin */}
      <dl class="about-details">
        <div>
          <dt class="eyebrow">Contact</dt>
          <dd><a class="text-link" href="mailto:abbycromwell@ucla.edu">abbycromwell at ucla dot edu</a></dd>
        </div>
        <div>
          <dt class="eyebrow">Resume</dt>
          <dd><a class="text-link" href="/resume/">View the resume <span aria-hidden="true">→</span></a></dd>
        </div>
        <div>
          <dt class="eyebrow">Work</dt>
          <dd><a class="text-link" href="/work/">View the work <span aria-hidden="true">→</span></a></dd>
        </div>
      </dl>
    </section>
  </div>
</Base>

<style>
  .about {
    max-width: var(--max-width-wide);
    margin-inline: auto;
    padding: var(--space-page-top) var(--space-edge) var(--space-section);
  }

  h1 {
    margin-bottom: var(--space-xl);
    font-size: var(--text-display);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
  }

  .about__copy {
    display: grid;
    gap: var(--space-lg);
    max-width: var(--max-width-prose);
    color: var(--color-text-secondary);
    font-size: var(--text-xl);
    line-height: var(--leading-tight);
  }

  .about__copy p {
    margin-bottom: 0;
  }

  .about-details {
    margin: var(--space-2xl) 0 0;
  }

  .about-details > div {
    padding-block: var(--space-sm) var(--space-md);
    border-top: var(--border-thin) solid var(--color-border);
  }

  .about-details dt {
    margin-bottom: var(--space-2xs);
  }

  .about-details dd {
    margin: 0;
    font-size: var(--text-base);
    line-height: var(--leading-normal);
  }

  @media (min-width: 75rem) {
    .about {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(14rem, 18rem);
      gap: var(--space-2xl);
      align-items: start;
    }

    .about-details {
      /* clears the kicker so the first rule aligns with the title's cap height */
      margin-top: var(--space-xl);
    }
  }
</style>
