---
import Base from '../../layouts/Base.astro';
---

<Base
  title="Work — Abby Cromwell"
  description="Selected work by Abby Cromwell."
  activePage="work"
  atmospheric
>
  <div class="inner-page">
    <header class="page-intro">
      <p class="eyebrow">Selected work</p>
      <h1>Worlds,<br />characters,<br />stories.</h1>
      <p>Illustrative art and character-led storytelling for entertainment worlds.</p>
    </header>

    <section class="work-grid" aria-label="Selected work">
      <a class="work-card work-card--featured" href="/case-study/">
        <span>01 / Case study</span>
        <strong>Project forthcoming</strong>
        <small>Open case study →</small>
      </a>
    </section>

    <section class="work-placeholder" aria-label="Artwork placeholder">
      <span>New work arriving</span>
    </section>
  </div>
</Base>

<style>
  .inner-page {
    min-height: 100vh;
    overflow: hidden;
  }

  .page-intro {
    max-width: var(--max-width-wide);
    margin-inline: auto;
    padding: var(--space-page-top) var(--space-edge) var(--space-section);
  }

  h1 {
    margin-bottom: var(--space-lg);
    font-size: var(--text-display);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
  }

  .page-intro > p:last-child {
    max-width: var(--max-width-prose);
    margin-bottom: 0;
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
  }

  .work-grid {
    display: grid;
    max-width: var(--max-width-wide);
    margin-inline: auto;
    border: var(--border-thin) solid var(--color-border);
    background: var(--color-border);
    gap: var(--border-thin);
  }

  .work-card {
    position: relative;
    isolation: isolate;
    display: flex;
    aspect-ratio: 1.13 / 1;
    min-width: 0;
    overflow: hidden;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-lg);
    color: var(--color-text-on-dark);
    background: var(--color-bg-dark);
  }

  .work-card::after {
    position: absolute;
    z-index: -1;
    inset: 0;
    content: "";
    background: var(--color-dark-overlay);
    transition: background var(--duration-standard) var(--ease-out);
  }

  .work-card img {
    position: absolute;
    z-index: -2;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-standard) var(--ease-out);
  }

  .work-card span,
  .work-card small {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .work-card strong {
    max-width: 14ch;
    font-size: var(--text-art-title);
    font-weight: var(--weight-normal);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
  }

  .work-card--featured {
    aspect-ratio: 2.25 / 1;
  }

  .work-placeholder {
    display: grid;
    min-height: min(32vw, 24rem);
    max-width: var(--max-width-wide);
    margin-inline: auto;
    margin-block: var(--space-section);
    place-items: center;
    border-block: var(--border-thin) solid var(--color-border);
    color: var(--color-text-secondary);
    background: var(--color-paper-overlay);
  }

  .work-placeholder span {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  a.work-card:hover,
  a.work-card:focus-visible {
    color: var(--color-text-on-dark);
  }

  a.work-card:hover::after,
  a.work-card:focus-visible::after {
    background: var(--color-dark-overlay-soft);
  }

  a.work-card:hover img,
  a.work-card:focus-visible img {
    transform: scale(1.02);
  }

  @media (min-width: 48rem) {
    .work-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .work-card--featured {
      grid-column: span 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .work-card::after,
    .work-card img {
      transition: none;
    }
  }
</style>
