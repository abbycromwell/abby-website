---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { chapters } from '../../data/work.js';
import heroWatercolor from '../../assets/home/hero-watercolor-veins.png';
import songbookCover from '../../assets/case-study/spread-01.webp';
import songbookGlyphs from '../../assets/case-study/spread-07.webp';
import songbookDoki from '../../assets/case-study/spread-17.webp';

/* the book speaks with its own pages, not a stand-in */
const songbookSpreads = [
  { src: songbookCover, alt: 'SongBook cover: coral watercolor streaks with the song title in red display letters' },
  { src: songbookGlyphs, alt: 'SongBook page of monumental black Futura glyphs on a salmon ground' },
  { src: songbookDoki, alt: 'SongBook page: red lyric poster with a monumental 女 character' },
];
---

<!--
  THESIS: The gallery is the homepage's watercolor at full concentration, and a
  capillary carries you through it; refuses both the thumbnail-grid archive and
  the flat dark room.
  OWN-WORLD: Deep brown-red ground with the hero wash pooled inside it, fine red
  vein filaments still crossing, framed plates on coral hairlines, compressed Jost
  uppercase, wet-red interaction points.
  STORY: An employer reads four contents rows, descends into the gallery with the
  vein tracking position, meets the book at full width, leaves toward About.
  FIRST VIEWPORT: Compressed headline anchors left over paper; the contents table
  begins beneath, its first rule the invitation to scroll.
  FORM: The Capillary Rail over a washed-through ground — candidate 1 of 7 grounded
  structures with ground variant 10, chosen by Vivian against seed bb0fdb07, which
  assigned candidate 7. Staging: clips play only while in view; nothing moves position.
-->
<Base
  title="Work — Abby Cromwell"
  description="Selected work by Abby Cromwell: typography, illustration, animation, and sketch."
  activePage="work"
  atmospheric
>
  <div class="inner-page">
    <header class="page-intro">
      <h1>Selected work</h1>
    </header>

    <nav class="plate-index" aria-label="Contents">
      <ol>
        {chapters.map((chapter) => (
          <li>
            <a class="plate-index__row" href={`#${chapter.slug}`}>
              <span class="plate-index__no">{chapter.no}</span>
              <span class="plate-index__name">{chapter.title}</span>
              <span class="plate-index__meta">
                {chapter.plates ? `${chapter.plates.length} works` : 'Case study'}
              </span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <div class="gallery">
      <Image
        class="gallery__wash"
        src={heroWatercolor}
        alt=""
        aria-hidden="true"
        loading="lazy"
        widths={[768, 1152, 1536]}
        sizes="100vw"
      />

      {/*
        The capillary: one vein down the gallery carrying position, branching
        once per chapter. It is the homepage's own filament doing the navigating,
        so the two pages share a mark rather than a widget.
      */}
      <nav class="vein" aria-label="Chapters">
        <ol>
          {chapters.map((chapter) => (
            <li>
              <a class="vein__node" href={`#${chapter.slug}`} data-vein={chapter.slug}>
                <span class="vein__no">{chapter.no}</span>
                <span class="vein__name">{chapter.title}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>

      {chapters.map((chapter) => {
        if (chapter.kind === 'case-study') {
          return (
            <section id={chapter.slug} class="chapter chapter--book" aria-labelledby="ch-typography">
              <h2 id="ch-typography" class="book__display" lang="ja">{chapter.display}</h2>
              <p class="book__premise">{chapter.premise}</p>
              <ul class="book__spreads">
                {songbookSpreads.map(({ src, alt }) => (
                  <li>
                    <Image
                      src={src}
                      alt={alt}
                      widths={[480, 768, 1152]}
                      sizes="(min-width: 48rem) 30vw, 90vw"
                      loading="lazy"
                    />
                  </li>
                ))}
              </ul>
              <a class="book__cta" href={chapter.href}>
                Read SongBook <span aria-hidden="true">→</span>
              </a>
            </section>
          );
        }

        const empty = chapter.plates.every((plate) => !plate);
        return (
          <section id={chapter.slug} class="chapter" aria-labelledby={`ch-${chapter.slug}`}>
            <header class="chapter__rule">
              <h2 id={`ch-${chapter.slug}`}>
                <span class="chapter__no">{chapter.no}</span>
                {chapter.title}
              </h2>
              <p>{empty ? `${chapter.plates.length} works · forthcoming` : `${chapter.plates.length} works`}</p>
            </header>
            {/* Empty plate grids are decorative; aria-hidden lifts once artwork lands. */}
            <ul class={`chapter__grid chapter__grid--${chapter.layout}`} aria-hidden={empty ? 'true' : undefined}>
              {chapter.plates.map((plate) => (
                <li>
                  {plate?.clip ? (
                    <figure class="plate plate--filled">
                      <video
                        class="plate__clip"
                        src={plate.clip}
                        muted
                        loop
                        playsinline
                        preload="metadata"
                        aria-label={plate.alt}
                      ></video>
                    </figure>
                  ) : plate ? (
                    <figure class="plate plate--filled">
                      <Image
                        src={plate.src}
                        alt={plate.alt}
                        widths={[480, 768, 1152]}
                        sizes="(min-width: 48rem) 45vw, 95vw"
                        loading="lazy"
                      />
                    </figure>
                  ) : (
                    <div class="plate">
                      <span class="plate__label">Forthcoming</span>
                    </div>
                  )}
                </li>
              ))}
            </ul>
          </section>
        );
      })}
    </div>

    <aside class="page-close">
      <p>Illustrative art and character-led storytelling for entertainment worlds.</p>
      <a href="/about/">About the artist <span aria-hidden="true">→</span></a>
    </aside>
  </div>
</Base>

<style>
  .inner-page {
    min-height: 100vh;
    overflow: hidden;
  }

  .page-intro {
    max-width: var(--max-width-wide);
    margin-inline: auto;
    padding: var(--space-page-top) var(--space-edge) var(--space-xl);
  }

  /* Matches the homepage hero name: light, wide-tracked, Name Red */
  h1 {
    margin-bottom: 0;
    color: var(--color-hero-name);
    /* min() keeps the single line inside narrow screens */
    font-size: min(var(--text-display), 8.5vw);
    font-weight: var(--weight-light);
    line-height: var(--leading-hero);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  /* Table of plates */

  .plate-index {
    max-width: var(--max-width-wide);
    margin-inline: auto;
    padding-inline: var(--space-edge);
  }

  .plate-index ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .plate-index__row {
    display: grid;
    grid-template-columns: minmax(2.5rem, 4rem) minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-md);
    padding-block: var(--space-lg);
    border-top: var(--border-thin) solid var(--color-border);
    color: var(--color-text);
  }

  .plate-index li:last-child .plate-index__row {
    border-bottom: var(--border-thin) solid var(--color-border);
  }

  .plate-index__no {
    color: var(--color-hero-name);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
  }

  .plate-index__name {
    font-size: var(--text-xl);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .plate-index__row:hover .plate-index__name,
  .plate-index__row:focus-visible .plate-index__name {
    color: var(--color-accent);
  }

  .plate-index__meta {
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  /* Gallery */

  .gallery {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-top: var(--space-section);
    padding-block: var(--space-xl) var(--space-section);
    color: var(--color-text-on-dark);
    background: var(--color-bg-dark);
  }

  /*
    The dark is the homepage's wash at full concentration, not a different
    material. Screen lets the coral and its vein filaments surface through the
    oxblood as pooled pigment, so the ground is never a flat dark room and the
    two pages stay recognisably the same watercolor.
  */
  .gallery__wash {
    position: absolute;
    z-index: -1;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    mix-blend-mode: screen;
    opacity: 0.22;
  }

  /* ─── the capillary ─── */

  .vein {
    display: none;
  }

  .chapter {
    max-width: var(--max-width-wide);
    margin-inline: auto;
    padding-inline: var(--space-edge);
    scroll-margin-top: var(--space-xl);
  }

  .chapter + .chapter {
    margin-top: var(--space-section);
  }

  .chapter__rule {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-lg);
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-sm);
    border-bottom: var(--border-thin) solid var(--color-border);
  }

  .chapter__rule h2 {
    flex: 1 1 auto;
    margin: 0;
    font-size: var(--text-xl);
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
  }

  .chapter__no {
    margin-right: var(--space-sm);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
  }

  .chapter__rule p {
    margin: 0;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Featured case plate — the SongBook cover, pure artwork as the link */

  .case-plate {
    position: relative;
    display: block;
    border: var(--border-thin) solid var(--color-border);
  }

  .case-plate img {
    display: block;
    width: 100%;
    height: auto;
  }

  .case-plate__cta {
    position: absolute;
    bottom: var(--space-md);
    left: var(--space-md);
    color: var(--color-hero-name);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .case-plate:hover .case-plate__cta,
  .case-plate:focus-visible .case-plate__cta {
    color: var(--color-accent);
  }

  /* Plates */

  /* Framed hang: each plate carries its own hairline frame on the dark wall */
  .chapter__grid {
    display: grid;
    margin: 0;
    padding: 0;
    gap: var(--space-md);
    list-style: none;
  }

  .chapter__grid li {
    min-width: 0;
  }

  .chapter__grid--dense {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .chapter__grid--dense li:first-child {
    grid-column: span 2;
  }

  .plate {
    position: relative;
    isolation: isolate;
    height: 100%;
    aspect-ratio: 4 / 3;
    margin: 0;
    border: var(--border-thin) solid var(--color-border);
    background: var(--color-bg-dark);
  }

  /* Membrane wash for plates still awaiting artwork */
  .plate:not(.plate--filled)::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    content: "";
    background: var(--color-paper-overlay);
  }

  .chapter__grid--trio .plate {
    aspect-ratio: 1 / 1;
  }

  .chapter__grid--wide .plate {
    aspect-ratio: 4 / 3;
  }

  .chapter__grid--dense .plate {
    aspect-ratio: 4 / 5;
  }

  .chapter__grid--dense li:first-child .plate {
    aspect-ratio: 1.63 / 1;
  }

  .plate--filled img,
  .plate--filled .plate__clip {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Clips letterbox onto the dark ground instead of cropping motion */
  .plate--filled .plate__clip {
    object-fit: contain;
  }

  .plate__label {
    position: absolute;
    top: var(--space-md);
    left: var(--space-md);
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  /* Close */

  .page-close {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-lg);
    max-width: var(--max-width-wide);
    margin-inline: auto;
    padding: var(--space-section) var(--space-edge);
  }

  .page-close p {
    max-width: var(--max-width-prose);
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
  }

  .page-close a {
    color: var(--color-hero-name);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    white-space: nowrap;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .page-close a:hover,
  .page-close a:focus-visible {
    color: var(--color-accent);
  }


  /* ─── the book ─── */

  /*
    The one chapter that is a project rather than a collection, so the one that
    changes the ground. Everything else keeps a quiet numbered rule; if all four
    shouted, none of them would.
  */
  .chapter--book {
    max-width: none;
    margin-block: var(--space-section);
    padding-block: var(--space-section);
    padding-inline: var(--space-edge);
    background: var(--color-hero-name);
    text-align: center;
  }

  .book__display {
    max-width: 18ch;
    margin: 0 auto var(--space-md);
    color: var(--color-bg);
    font-size: var(--text-display);
    font-weight: var(--weight-light);
    line-height: var(--leading-hero);
    letter-spacing: var(--tracking-label);
  }

  .book__premise {
    margin: 0 0 var(--space-xl);
    color: var(--color-border);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .book__spreads {
    display: grid;
    gap: var(--space-xs);
    max-width: var(--max-width-wide);
    margin: 0 auto var(--space-xl);
    padding: 0;
    list-style: none;
  }

  .book__spreads img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: var(--border-thin) solid var(--color-border);
  }

  .book__cta {
    display: inline-block;
    padding-bottom: var(--space-2xs);
    border-bottom: var(--border-thin) solid var(--color-border);
    color: var(--color-bg);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-decoration: none;
    text-transform: uppercase;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .book__cta:hover,
  .book__cta:focus-visible {
    color: var(--color-border);
  }

  @media (min-width: 48rem) {
    /*
      The vein only exists where there is margin to hold it. Below 48rem the
      contents table at the top is the whole navigation, as it was.
    */
    /*
      A grid column, not a float. Sticky on a floated zero-width box is fragile
      and rendered nothing; the rail gets a real track and the chapters get the
      rest, so no plate can ever sit under the vein.
    */
    .gallery {
      display: grid;
      grid-template-columns: calc(var(--space-edge) + var(--space-2xl)) minmax(0, 1fr);
    }

    .vein {
      display: block;
      position: sticky;
      top: 0;
      grid-column: 1;
      grid-row: 1 / -1;
      align-self: start;
      height: 100svh;
      padding-left: var(--space-edge);
      pointer-events: none;
    }

    .vein ol {
      display: flex;
      flex-direction: column;
      justify-content: space-evenly;
      height: 100%;
      margin: 0;
      padding: 0;
      list-style: none;
      /* the filament itself, thickening as the pigment dries downward */
      background:
        linear-gradient(var(--color-border), var(--color-accent)) center / var(--border-thin) 100%
        no-repeat;
    }

    .vein__node {
      display: flex;
      align-items: center;
      gap: var(--space-xs);
      margin-left: calc(var(--space-xs) * -1);
      color: var(--color-border);
      font-size: var(--text-xs);
      letter-spacing: var(--tracking-label);
      text-decoration: none;
      text-transform: uppercase;
      white-space: nowrap;
      pointer-events: auto;
      transition: color var(--duration-fast) var(--ease-out);
    }

    /* the node is a bead on the filament, in the pods' own silhouette */
    .vein__no {
      flex: 0 0 auto;
      width: var(--space-sm);
      height: var(--space-sm);
      border-radius: 58% 42% 47% 53% / 45% 52% 48% 55%;
      background: var(--color-border);
      font-size: 0;
      transition:
        background var(--duration-fast) var(--ease-out),
        transform var(--duration-standard) var(--ease-out);
    }

    .vein__name {
      opacity: 0;
      transition: opacity var(--duration-standard) var(--ease-out);
    }

    .vein__node:hover,
    .vein__node:focus-visible,
    .vein__node[aria-current='true'] {
      color: var(--color-accent);
    }

    .vein__node:hover .vein__name,
    .vein__node:focus-visible .vein__name,
    .vein__node[aria-current='true'] .vein__name {
      opacity: 1;
    }

    /* the current chapter swells, the way a pod does under the pointer */
    .vein__node[aria-current='true'] .vein__no {
      background: var(--color-accent);
      transform: scale(1.8);
    }

    .vein__node:focus-visible {
      outline: var(--border-thin) solid var(--color-accent);
      outline-offset: var(--space-xs);
    }

    .chapter {
      grid-column: 2;
      margin-inline: 0;
      padding-left: 0;
    }

    /* the book is the one thing that crosses the rail's track, full width */
    .chapter--book {
      grid-column: 1 / -1;
      padding-left: var(--space-edge);
    }

    .book__spreads {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .chapter__grid--trio {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .chapter__grid--wide {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .chapter__grid--wide li:first-child {
      grid-column: span 2;
    }

    .chapter__grid--wide li:first-child .plate {
      aspect-ratio: 2.25 / 1;
    }

    .chapter__grid--dense {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>

<script>
  /*
    The vein tracks position. IntersectionObserver rather than a scroll handler,
    so this costs nothing while the page sits still.
  */
  const nodes = document.querySelectorAll('.vein__node');
  const sections = document.querySelectorAll('.gallery .chapter');

  if (nodes.length && sections.length) {
    const mark = (slug) => {
      for (const node of nodes) {
        node.toggleAttribute('aria-current', node.dataset.vein === slug);
        if (node.dataset.vein === slug) node.setAttribute('aria-current', 'true');
      }
    };

    const seen = new Map();
    const spy = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) seen.set(entry.target, entry.intersectionRatio);
        let best = null;
        let bestRatio = 0;
        for (const [section, ratio] of seen) {
          if (ratio > bestRatio) {
            bestRatio = ratio;
            best = section;
          }
        }
        if (best) mark(best.id);
      },
      { threshold: [0, 0.15, 0.35, 0.6, 0.9] },
    );

    for (const section of sections) spy.observe(section);
  }

  const clips = document.querySelectorAll('.plate__clip');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduceMotion || !('IntersectionObserver' in window)) {
    clips.forEach((clip) => clip.setAttribute('controls', ''));
  } else {
    const stage = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.play().catch(() => {});
          } else {
            entry.target.pause();
          }
        }
      },
      { threshold: 0.35 }
    );
    clips.forEach((clip) => stage.observe(clip));
  }
</script>
