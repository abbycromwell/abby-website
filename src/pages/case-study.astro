---
import Base from '../layouts/Base.astro';
---

<Base
  title="Case Study — Abby Cromwell"
  description="Case study by Abby Cromwell."
  atmospheric
>
  <div class="case-study">
    <header class="case-header">
      <p class="eyebrow">Case study / forthcoming</p>
      <h1>Project title<br />to come.</h1>
      <p>
        This page is ready for a project narrative, process notes, final artwork,
        and credits once Abby chooses the first case study.
      </p>
    </header>

    <section class="case-placeholder" aria-label="Artwork placeholder">
      <span>Hero artwork</span>
    </section>

    <section class="case-notes" aria-label="Project details">
      <div><p class="eyebrow">Role</p><p>To be defined</p></div>
      <div><p class="eyebrow">Medium</p><p>To be defined</p></div>
      <div><p class="eyebrow">Year</p><p>To be defined</p></div>
    </section>
  </div>
</Base>

<style>
  .case-study {
    overflow: hidden;
  }

  .case-header,
  .case-notes {
    max-width: var(--max-width-wide);
    margin-inline: auto;
    padding-inline: var(--space-edge);
  }

  .case-header {
    padding-top: var(--space-page-top);
    padding-bottom: var(--space-xl);
  }

  h1 {
    margin-bottom: var(--space-lg);
    font-size: var(--text-display);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
  }

  .case-header > p:last-child {
    max-width: var(--max-width-prose);
    margin-bottom: 0;
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
  }

  .case-placeholder {
    display: grid;
    min-height: min(58vw, 44rem);
    max-width: var(--max-width-wide);
    margin-inline: auto;
    place-items: center;
    border-block: var(--border-thin) solid var(--color-border);
    color: var(--color-text-secondary);
    background: var(--color-paper-overlay);
  }

  .case-placeholder span {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .case-notes {
    display: grid;
    gap: var(--space-lg);
    padding-top: var(--space-section);
    padding-bottom: var(--space-section);
  }

  .case-notes > div {
    border-top: var(--border-thin) solid var(--color-border);
    padding-top: var(--space-md);
  }

  .case-notes > div > p:last-child {
    margin-bottom: 0;
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
  }

  @media (min-width: 48rem) {
    .case-notes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
