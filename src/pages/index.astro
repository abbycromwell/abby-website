---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import heroWatercolor from '../assets/home/hero-watercolor-veins.png';
import { pods } from '../data/home-previews.js';

/*
  The pod colour sampler reads the wash through a CSS custom property, and
  `heroWatercolor.src` hands back the untouched 2.3MB PNG — every desktop visitor
  was downloading it to tint three bubbles. Nothing about a 50%-opacity colour
  blend depends on resolution, so the sampler gets the narrowest variant.
*/
const heroWashSampler = await getImage({
  src: heroWatercolor,
  width: 768,
  format: 'webp',
});

/*
  With preload="none" the browser has no frame to show until the clip plays, so
  every clip pod needs a poster. Resolved here rather than in the data file
  because getImage is what turns the source frame into the webp browsers get.
*/
const posters = new Map(
  await Promise.all(
    pods
      .filter((pod) => pod.poster)
      .map(async ({ slug, poster }) => [
        slug,
        (await getImage({ src: poster, width: 640, format: 'webp' })).src,
      ]),
  ),
);
---

<!--
  THESIS: Abby's work emerges from a translucent anatomical watercolor field, refusing a generic portfolio grid.
  OWN-WORLD: Warm paper, coral wash, wet red, dried oxblood, geometric type, and image-led transitions.
  STORY: Visitors meet Abby, understand her disciplines, and enter her work through three living pods.
  FIRST VIEWPORT: Minimal navigation floats above a monumental left-anchored name; three artwork pods hang in the right half.
  FORM: The watercolor-greenhouse direction — "projects hang as living pods" — over the pinned "The Meninges" field.
-->
<Base immersive>
  <section class="hero" aria-labelledby="hero-title">
    <Image
      class="hero__watercolor"
      src={heroWatercolor}
      alt="Pale coral watercolor wash branching across a warm paper field"
      loading="eager"
      widths={[768, 1152, 1536]}
      sizes="100vw"
    />

    <div class="hero__content">
      <h1 id="hero-title"><span class="h1__line">Abby</span><br /><span class="h1__line h1__second">Cromwell</span></h1>
      <p class="hero__discipline">
        Illustrative art <span aria-hidden="true">·</span> Character design
        <span aria-hidden="true">·</span> Storytelling
      </p>
    </div>

    <ul class="pods" aria-label="Work by category">
      {pods.map(({ slug, title, href, src, alt, clip, sizes }, index) => (
        <li class={`pod pod--${slug}`}>
          <a class="pod__link" href={href}>
            <span class="pod__drag">
              <span class="pod__skin">
                {clip ? (
                  /*
                    preload="none", not "metadata". Metadata opened a request
                    against a 5MB file and held it for 439ms during the load, to
                    fetch a first frame the poster now supplies for 12kB. The
                    file itself is still only pulled when the pod is scrolled to.
                  */
                  <video
                    class="pod__clip"
                    src={clip}
                    poster={posters.get(slug)}
                    aria-label={alt}
                    muted
                    loop
                    playsinline
                    preload="none"
                  />
                ) : (
                  /*
                    The first pod is the page's LCP element — the wash behind it
                    is too low-entropy for Chrome to count. Without the hint it
                    is fetched at the same priority as the pods below the fold.
                  */
                  <Image
                    src={src}
                    alt={alt}
                    loading="eager"
                    fetchpriority={index === 0 ? 'high' : undefined}
                    widths={[288, 432, 576]}
                    sizes={sizes}
                  />
                )}
              </span>
            </span>
            <span class="pod__title">{title}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style define:vars={{ heroWash: `url(${heroWashSampler.src})` }}>
  /*
    Each pod animates its own edge feather, so the radial-gradient stop has to be
    a registered property. Without @property it would snap instead of bleed.
  */
  @property --feather {
    syntax: "<percentage>";
    inherits: false;
    initial-value: 57%;
  }

  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 100svh;
    padding: var(--space-hero-top) var(--space-edge) var(--space-xl);
    background: var(--color-bg);
  }

  .hero__watercolor {
    position: absolute;
    z-index: -1;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero__content {
    width: 100%;
  }

  /*
    No max-width. "Cromwell" is wider than 10ch at every viewport, so the old
    bound never constrained anything — it only made the box lie about where the
    ink ends, which is what let the word run under the pods and off the phone.

    The display token's floor was 4rem, which stopped the type shrinking below
    ~711px and pushed the ink off the phone. Fixed at the token, not here.
  */
  h1 {
    margin-bottom: var(--space-xs);
    color: var(--color-hero-name);
    font-size: var(--text-display);
    font-weight: var(--weight-light);
    line-height: var(--leading-hero);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  /*
    The name arrived unannounced while the pods beside it were choreographed over
    1.4s, which reads backwards. It rises rather than wipes: a hard clip edge is
    the wrong vocabulary beside feathered masks, and at --leading-hero 1.05 it
    would sit on the caps anyway.

    inline-block because transform does not apply to a non-replaced inline box.
    The <br> still owns the line break, so both lines stay where they were.

    Two animations rather than one keyframe holding opacity at an intermediate
    stop: a timing function is applied per interval, so that would ease the rise
    twice and kink it mid-travel. Split, the ink is painted at 240ms while the
    rise runs its full 640ms.
  */
  .h1__line {
    display: inline-block;
    animation:
      name-rise var(--duration-slow) var(--ease-out) both,
      name-fade var(--duration-standard) var(--ease-out) both;
  }

  @keyframes name-rise {
    from {
      transform: translateY(0.14em);
    }
  }

  @keyframes name-fade {
    from {
      opacity: 0;
    }
  }

  /* optical: pull C flush with the A apex and the label axis below */
  .h1__second {
    margin-left: -0.07em;
    /* close enough to read as one gesture, far enough to be two */
    animation-delay: 90ms;
  }

  /* the 4px inset sits the label axis under the A's stem, not the glyph edge */
  .hero__discipline {
    animation: name-fade var(--duration-standard) var(--ease-out) 180ms both;
    max-width: var(--max-width-prose);
    margin-left: var(--space-2xs);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-label);
    line-height: var(--leading-normal);
    text-transform: uppercase;
  }

  .hero__discipline span {
    color: var(--color-hero-name);
  }

  .pods {
    display: grid;
    gap: var(--space-2xl);
    margin: var(--space-2xl) 0 0;
    padding: 0;
    list-style: none;
  }

  .pod {
    width: min(20rem, 78vw);
    margin-inline: auto;
  }

  .pod--illustration {
    --pod-shape: 58% 42% 47% 53% / 45% 52% 48% 55%;
    --pod-shape-held: 30% 70% 68% 32% / 65% 28% 72% 35%;
    --pod-shape-drift: 72% 28% 35% 65% / 30% 68% 32% 70%;
  }

  .pod--animation {
    --pod-shape: 44% 56% 62% 38% / 57% 41% 59% 43%;
    --pod-shape-held: 70% 30% 28% 72% / 32% 68% 35% 65%;
    --pod-shape-drift: 28% 72% 65% 35% / 68% 30% 70% 32%;
  }

  .pod--typography {
    --pod-shape: 51% 49% 38% 62% / 44% 61% 39% 56%;
    --pod-shape-held: 25% 75% 62% 38% / 70% 35% 65% 30%;
    --pod-shape-drift: 68% 32% 30% 70% / 33% 72% 28% 67%;
  }

  /*
    The radius is here as well as on the skin because border-radius clips hit
    testing. Without it the link is a square and ~21% of each pod's clickable
    area is transparent paper that navigates.
  */
  .pod__link {
    display: block;
    position: relative;
    border-radius: var(--pod-shape);
    color: inherit;
    text-decoration: none;
  }

  /*
    Carries the pointer-driven deformation only. Rotating to the drag axis,
    stretching along it, then rotating back elongates the membrane in the
    direction of travel rather than squashing it on the screen axes.

    The blend must sit here, not on the skin: this element's transform makes a
    stacking context, and mix-blend-mode only sees the backdrop of its own
    context — on the skin it would blend against nothing and the pod would stop
    sinking into the watercolor.
  */
  .pod__drag {
    display: block;
    mix-blend-mode: multiply;
    transform:
      translate(var(--drag-x, 0px), var(--drag-y, 0px))
      rotate(var(--drag-angle, 0deg))
      scale(var(--drag-stretch, 1), var(--drag-squash, 1))
      rotate(calc(var(--drag-angle, 0deg) * -1));
  }

  .pod__skin {
    display: block;
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: var(--pod-shape);
    opacity: 1;
    /*
      The stops end at 72%, not 92%. A radial-gradient sizes to farthest-corner,
      so on a square the box's edge midpoints sit at exactly 70.71% of the
      gradient radius. The stop lands there, so alpha reaches zero precisely
      where border-radius would otherwise cut a hard edge.
    */
    mask-image: radial-gradient(ellipse at center, #000 var(--feather), transparent 70.7%);
    transition:
      --feather var(--duration-standard) var(--ease-out),
      border-radius var(--duration-slow) var(--ease-out),
      opacity var(--duration-standard) var(--ease-out),
      transform var(--duration-standard) var(--ease-out);
    animation: pod-wake var(--duration-wake) var(--ease-in-out) both;
    /*
      Held until the pod is on screen; the waker in the script releases it.
      Pausing rather than withholding keeps the stagger delays and the
      reduced-motion override on this one declaration, and 0% is the resting
      shape at scale(1), so a held pod is pixel-identical to a still one.
    */
    animation-play-state: paused;
  }

  .pod.is-visible .pod__skin {
    animation-play-state: running;
  }

  /*
    Wake and wobble share the `animation` property, so hovering cancels an
    in-flight wake and un-hovering used to re-declare it — the pods breathed
    again every time the cursor left. Retired once it has run.
  */
  .pod.is-awake .pod__skin {
    animation: none;
  }

  /*
    Each pod takes its hue from the exact patch of wash it is sitting on.
    background-attachment: fixed pins this copy of the hero to the viewport, so
    the pixels inside the pod line up with the pixels around it, and blend-mode
    color keeps the artwork's own lightness while adopting the wash's hue.

    This also pulls the yellow back: multiply compounds two warm layers and
    starves the blue channel, and the wash's coral is what neutralises it.
  */
  .pod__skin::after {
    content: "";
    display: none;
    position: absolute;
    inset: 0;
    background-image: var(--heroWash);
    background-position: center;
    background-size: cover;
    background-attachment: fixed;
    mix-blend-mode: color;
    opacity: 0.5;
    pointer-events: none;
  }

  .pod__skin :global(img),
  .pod__clip {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /*
    One breath on load, staggered, then still. The pods are the page's only route
    into the work and at rest they read as part of the wash; a single deform says
    they are objects, and previews what hovering will do. It runs once rather
    than looping — permanent motion on a static page is noise, not an affordance.
  */
  @keyframes pod-wake {
    0% {
      border-radius: var(--pod-shape);
      transform: scale(1);
    }
    45% {
      border-radius: var(--pod-shape-held);
      transform: scale(1.045);
    }
    100% {
      border-radius: var(--pod-shape);
      transform: scale(1);
    }
  }

  /* they wake in sequence, so the eye is led across all three */
  .pod--animation .pod__skin {
    animation-delay: 180ms;
  }

  .pod--typography .pod__skin {
    animation-delay: 360ms;
  }

  /*
    A bubble never holds a shape. While the pointer is on it the silhouette drifts
    between three states instead of settling, which is what separates a membrane
    from a masked image.

    0% and 100% sit exactly at the resting shape and scale. An animation does not
    transition in, so any gap here would be an instant jump the moment the pointer
    lands. The swell happens inside the loop instead.
  */
  @keyframes pod-wobble {
    0% {
      border-radius: var(--pod-shape);
      transform: translate(0, 0) scale(1);
    }
    25% {
      border-radius: var(--pod-shape-held);
      transform: translate(5%, -6%) scale(1.09);
    }
    50% {
      border-radius: var(--pod-shape-drift);
      transform: translate(-4.5%, 5%) scale(1.04);
    }
    75% {
      border-radius: var(--pod-shape-held);
      transform: translate(6%, 3.5%) scale(1.08);
    }
    100% {
      border-radius: var(--pod-shape);
      transform: translate(0, 0) scale(1);
    }
  }

  /* keyboard focus reveals on any device, including touch */
  .pod__link:focus-visible .pod__skin {
    --feather: 64%;
    /* the artwork comes forward on engagement; it used to fade to 0.4, which
       made the reward for caring about Abby's work that it got harder to see */
    opacity: 1;
    animation: pod-wobble var(--duration-drift) var(--ease-in-out) infinite;
  }

  .pod__link:focus-visible .pod__title {
    opacity: 1;
    transform: scale(1);
  }

  /* a tap fires a phantom hover, so pointer motion is gated to real pointers */
  @media (hover: hover) and (pointer: fine) {
    .pod__link:hover .pod__skin {
      --feather: 64%;
      opacity: 1;
      animation: pod-wobble var(--duration-drift) var(--ease-in-out) infinite;
    }

    .pod__link:hover .pod__title {
      opacity: 1;
      transform: scale(1);
    }
  }

  /*
    Two-tone and 2px: a single 1px Name Red ring measured ~2.5:1 against the
    wash's darkest veins, under both the 3:1 non-text floor and SC 2.4.13's 2px
    minimum. The paper under-ring guarantees the boundary wherever the wash goes
    dark, which is exactly where the Animation pod sits.
  */
  .pod__link:focus-visible {
    outline: 2px solid var(--color-hero-name);
    outline-offset: var(--space-2xs);
    box-shadow: 0 0 0 4px var(--color-bg);
  }

  /*
    The name appears on approach only — pinned by Vivian, against the critique's
    reading that it leaves the page's only route into the work invisible at rest.

    pointer-events: none so the mask governs the clickable region; this element
    spans the pod's bounding square and was swallowing the transparent corners.
  */
  .pod__title {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--color-hero-name);
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-align: center;
    text-transform: uppercase;
    pointer-events: none;
    opacity: 0;
    transform: scale(0.96);
    transition:
      opacity var(--duration-standard) var(--ease-out),
      transform var(--duration-standard) var(--ease-out);
  }

  @media (max-width: 47.99rem) {
    /* no hover on touch, so the names stay put below their pods */
    .pod__title {
      position: static;
      margin-top: var(--space-sm);
      opacity: 1;
      transform: none;
    }
  }

  @media (min-width: 48rem) {
    /*
      The pods hang between roughly 20% and 80% of the field. Pinning the name to
      the top padding left it floating above all of that with dead paper beneath,
      so the left column centres against them instead.

      Two real columns now. The pods used to float in an absolute layer spanning
      the whole hero, kept off the name by percentages tuned at one window size;
      anything they overran was cut silently by `overflow: hidden`. Here the type
      takes a max-content column and the pods get the remainder, so the browser
      computes the boundary between them and it tracks the type at every width.
    */
    .hero {
      display: grid;
      grid-template-columns: max-content minmax(0, 1fr);
      column-gap: var(--space-edge);
      /* 40/60: optically centred sits a little above true centre */
      grid-template-rows: 4fr auto 6fr;
    }

    .hero__content {
      grid-column: 1;
      grid-row: 2;
    }

    /*
      The sampler is viewport-fixed, so it only tracks the hero where the hero
      does not scroll. Above 48rem the page is one non-scrolling screen; below it
      the hero is taller than the viewport and the two would drift apart.
    */
    .pod__skin::after {
      display: block;
    }

    /* oversize and pull left/up so the red wash reaches behind the pods */
    .hero__watercolor {
      top: -10%;
      left: -15%;
      width: 115%;
      height: 110%;
    }

    /*
      The pods' field: the second column, full height. Its left edge is wherever
      the type stopped, its top is the hero's own header clearance, and its right
      and bottom are the hero's padding. Nothing inside it can reach the name,
      the discipline line, or the Work/About links, because none of those are in
      it. The hero's padding is left over as slack for the hover wobble.
    */
    .pods {
      display: block;
      position: relative;
      grid-column: 2;
      grid-row: 1 / -1;
      /* the scatter would strand itself across 1200px of paper on an ultrawide */
      justify-self: end;
      width: min(100%, 60rem);
      margin: 0;
      pointer-events: none;

      /*
        The field's height as a length. A pod is square, so its height comes from
        its width — a horizontal percentage — while `top` resolves percentages
        against the height. Two different bases, so the vertical maths needs a
        real one. Understating it is the safe direction: the hero is never
        shorter than 100svh, so a taller hero only seats the pods higher.
      */
      --field-h: calc(100svh - var(--space-hero-top) - var(--space-xl));
      /*
        One size drives the whole ladder, so whichever bound bites, the
        18 / 13.5 / 10 ratio survives it. The two caps are the fluidity: a pod
        can be no taller than the field and no wider than it, which is what the
        old viewport-width clamps could not promise.
      */
      --pod-base: min(clamp(11rem, 25vw, 20.5rem), calc(0.42 * var(--field-h)));
    }

    .pod {
      position: absolute;
      /*
        The percentage term is of the field's width, matching `left` below. 56%
        is not a round number: below 57.1% of the field the Illustration pod's
        left edge is always clear of the Typography pod's right edge, and below
        58.2% Typography clears Animation, whatever the field's proportions. It
        is the one bound that keeps the three readable as three.
      */
      --pod-w: min(calc(var(--pod-k) * var(--pod-base)), calc(var(--pod-k) * 56%));
      /* the same size as a pure length, for the axis where percentages lie */
      --pod-h: calc(var(--pod-k) * var(--pod-base));
      width: var(--pod-w);
      /*
        Fractions of the FREE space, not of the field. At 1 the pod sits flush
        with the field's far edge and at 0 flush with the near one; there is no
        value in between that puts any part of it outside. The composition is
        still hand-placed, but it can no longer be hand-placed off the screen.
      */
      left: calc(var(--pod-x) * (100% - var(--pod-w)));
      top: calc(var(--pod-y) * (var(--field-h) - var(--pod-h)));
      margin-inline: 0;
      pointer-events: auto;
    }

    /* a clear 18 / 13.5 / 10 ladder — 18 and 17.5 read as the same size */
    .pod--illustration {
      --pod-k: 1;
      --pod-x: 0.92;
      --pod-y: 0.07;
    }

    .pod--animation {
      --pod-k: 0.84;
      --pod-x: 0.72;
      --pod-y: 0.95;
      /*
        Measured off the field's floor. `top` works from a length that ignores
        the width cap, so wherever that cap bites this pod would stop short of
        its own gap and float the whole composition upward.
      */
      top: auto;
      bottom: calc((1 - var(--pod-y)) * (var(--field-h) - var(--pod-h)));
    }

    /* the pod nearest the type; 0.08 buys air off "CROMWELL" at every width */
    .pod--typography {
      --pod-k: 0.6;
      --pod-x: 0.08;
      --pod-y: 0.48;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    /* the arrival still happens, it just stops travelling */
    .h1__line,
    .hero__discipline {
      animation: name-fade var(--duration-standard) var(--ease-out) both;
    }

    .pod__skin {
      transition: opacity var(--duration-standard) var(--ease-out);
      animation: none;
    }

    .pod__link:hover .pod__skin,
    .pod__link:focus-visible .pod__skin {
      border-radius: var(--pod-shape);
      transform: none;
      animation: none;
    }

    .pod__title {
      transform: none;
      transition: opacity var(--duration-standard) var(--ease-out);
    }
  }
</style>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  /*
    The clip is 4.8MB. With `autoplay` in the markup the browser pulled the whole
    file before this script ran, including ~3MB for reduced-motion visitors who
    would never see it move, and on phones long before the pod scrolled into view.
    So playback is driven from here instead, on `preload="metadata"`.

    Under reduced motion the clip waits with native controls, which is what
    DESIGN.md promises and what the old path silently failed to deliver: it left
    a frozen first frame with no way to play it.
  */
  for (const video of document.querySelectorAll('.pod__clip')) {
    /*
      No controls here: the clip sits inside the pod's anchor, and interactive
      controls nested in a link give conflicting keyboard and pointer behaviour,
      with the mask clipping the control bar besides. Under reduced motion the
      pod stays a still frame; the Work page plays the clip with proper controls.
    */
    if (reducedMotion.matches) continue;

    const watcher = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) video.play().catch(() => {});
          else video.pause();
        }
      },
      { threshold: 0.25 },
    );
    watcher.observe(video);
  }

  /*
    The membrane answers the drag. Pointer velocity is smoothed into an offset,
    the offset gives an angle and a magnitude, and the pod elongates along that
    axis while trailing behind the cursor. Let go and surface tension pulls it
    back to rest. The CSS wobble keeps running underneath, untouched.
  */
  const FRICTION = 0.84; // how fast a flick bleeds off
  const CHASE = 0.16; // how eagerly the offset follows the velocity
  const LAG = 0.55; // fraction of the offset spent trailing the cursor
  const MAX_STRETCH = 0.3; // elongation ceiling along the drag axis
  const SPEED_FOR_MAX = 85;
  const REST = 0.05;

  function wireDrag(pod) {
    const drag = pod.querySelector('.pod__drag');
    if (!drag) return;

    let lastX = 0;
    let lastY = 0;
    let tracking = false;
    let velocityX = 0;
    let velocityY = 0;
    let offsetX = 0;
    let offsetY = 0;
    let angle = 0;
    let running = false;

    function rest() {
      for (const name of ['--drag-x', '--drag-y', '--drag-angle', '--drag-stretch', '--drag-squash']) {
        drag.style.removeProperty(name);
      }
    }

    function tick() {
      velocityX *= FRICTION;
      velocityY *= FRICTION;
      offsetX += (velocityX - offsetX) * CHASE;
      offsetY += (velocityY - offsetY) * CHASE;

      const speed = Math.hypot(offsetX, offsetY);
      /* below the threshold the angle is noise, so the last one is held */
      if (speed > 0.6) angle = (Math.atan2(offsetY, offsetX) * 180) / Math.PI;
      const stretch = 1 + Math.min(speed / SPEED_FOR_MAX, 1) * MAX_STRETCH;

      drag.style.setProperty('--drag-x', `${(offsetX * LAG).toFixed(2)}px`);
      drag.style.setProperty('--drag-y', `${(offsetY * LAG).toFixed(2)}px`);
      drag.style.setProperty('--drag-angle', `${angle.toFixed(2)}deg`);
      drag.style.setProperty('--drag-stretch', stretch.toFixed(4));
      /* volume is conserved: what it gains along the axis it loses across it */
      drag.style.setProperty('--drag-squash', (1 / stretch).toFixed(4));

      /*
        Settling, not hover state, ends the loop. Gating on `tracking` meant a
        motionless pointer resting inside a pod kept a 60fps loop and its style
        writes alive indefinitely. The next pointermove restarts it.
      */
      if (speed < REST && Math.hypot(velocityX, velocityY) < REST) {
        running = false;
        rest();
        return;
      }
      requestAnimationFrame(tick);
    }

    pod.addEventListener(
      'pointermove',
      (event) => {
        if (reducedMotion.matches) return;
        if (tracking) {
          velocityX += event.clientX - lastX;
          velocityY += event.clientY - lastY;
        }
        lastX = event.clientX;
        lastY = event.clientY;
        tracking = true;
        if (!running) {
          running = true;
          requestAnimationFrame(tick);
        }
      },
      { passive: true },
    );

    const release = () => {
      tracking = false;
      if (!running) {
        running = true;
        requestAnimationFrame(tick);
      }
    };

    pod.addEventListener('pointerleave', release, { passive: true });
    /* a cancelled pointer never fires pointerleave, so the pod would stay bent */
    pod.addEventListener('pointercancel', release, { passive: true });
  }

  /*
    The wake says the pods are objects and not part of the wash, and it runs
    once. Firing all three at load spent that on paper nobody was looking at:
    below 48rem they stack down a hero taller than the viewport, so two of the
    three breathed off-screen. Above 48rem all three are already in frame, this
    resolves on the first pass, and the 180/360ms ladder reads as it did.
  */
  const waker = new IntersectionObserver(
    (entries, observer) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      }
    },
    { threshold: 0.35 },
  );

  for (const pod of document.querySelectorAll('.pod')) {
    wireDrag(pod);
    waker.observe(pod);
    pod
      .querySelector('.pod__skin')
      ?.addEventListener('animationend', () => pod.classList.add('is-awake'), { once: true });
  }
</script>
