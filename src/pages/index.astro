---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import heroWatercolor from '../assets/home/hero-watercolor-veins.png';
import recentProjectPanel from '../assets/home/recent-project-panel.png';
import previewRef1 from '../assets/home/preview-ref-1.png';
import previewRef2 from '../assets/home/preview-ref-2.png';
import previewRef3 from '../assets/home/preview-ref-3.png';

const heroPreviews = [
  {
    src: previewRef1,
    alt: 'Atmospheric watercolor figure tangled in branching pale forms',
  },
  {
    src: previewRef2,
    alt: 'Atmospheric watercolor portrait of a cloaked bird-like figure',
  },
  {
    src: previewRef3,
    alt: 'Atmospheric watercolor figure reaching toward a pale sun',
  },
];
---

<!--
  THESIS: Abby's work emerges from a translucent anatomical watercolor field, refusing a generic portfolio grid.
  OWN-WORLD: Warm paper, coral wash, wet red, dried oxblood, geometric type, and image-led transitions.
  STORY: Visitors meet Abby, understand her disciplines, preview three future works, then enter the selected-work reveal.
  FIRST VIEWPORT: Minimal navigation floats above a monumental left-anchored name; three artwork placeholders gather low.
  FORM: User-pinned “The Meninges” direction from the separate sleepy project; no generated seed.
-->
<Base immersive>
  <section class="hero" aria-labelledby="hero-title">
    <Image
      class="hero__watercolor"
      src={heroWatercolor}
      alt="Pale coral watercolor wash branching across a warm paper field"
      loading="eager"
      widths={[768, 1152, 1536]}
      sizes="100vw"
    />

    <div class="hero__content">
      <h1 id="hero-title">Abby<br /><span class="h1__second">Cromwell</span></h1>
      <p class="hero__discipline">
        Illustrative art <span>·</span> Character design <span>·</span> Storytelling
      </p>
      <a class="scroll-cue" href="#work">
        Scroll to explore
        <span aria-hidden="true">↓</span>
      </a>
    </div>

    <ul class="hero__work-previews" aria-label="Selected artwork previews">
      {heroPreviews.map(({ src, alt }) => (
        <li class="art-card">
          <Image
            src={src}
            alt={alt}
            loading="eager"
            widths={[320, 480, 640]}
            sizes="(min-width: 48rem) 14rem, 33vw"
          />
        </li>
      ))}
    </ul>
  </section>

  <section class="work-tease" id="work" aria-labelledby="work-title">
    <h2 class="work-tease__label" id="work-title">Selected work</h2>
    <a class="work-tease__panel" href="/work/" aria-label="Recent project">
      <Image
        src={recentProjectPanel}
        alt="Vivid coral and deep red watercolor veins with a dark pooled region at the right"
        loading="lazy"
        widths={[774]}
        sizes="(min-width: 48rem) 66vw, 100vw"
      />
      <span>Recent project</span>
    </a>
  </section>
</Base>

<style define:vars={{ heroWash: `url(${heroWatercolor.src})` }}>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: var(--space-hero-top) var(--space-edge) var(--space-lg);
    background: var(--color-bg);
  }

  .hero__watercolor {
    position: absolute;
    z-index: -1;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero__content {
    width: 100%;
  }

  h1 {
    max-width: 10ch;
    margin-bottom: var(--space-xs);
    color: var(--color-hero-name);
    font-size: var(--text-display);
    font-weight: var(--weight-light);
    line-height: var(--leading-hero);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  /* optical: pull C flush with the A apex and the label axis below */
  .h1__second {
    margin-left: -0.07em;
  }

  .hero__discipline {
    max-width: var(--max-width-prose);
    margin-bottom: var(--space-xl);
    margin-left: var(--space-2xs);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-label);
    line-height: var(--leading-normal);
    text-transform: uppercase;
  }

  .hero__discipline span {
    color: var(--color-hero-name);
  }

  .scroll-cue {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    margin-left: var(--space-2xs);
    color: var(--color-hero-name);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .scroll-cue > span {
    font-size: 0.9em;
  }

  .hero__work-previews {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-xs);
    width: 100%;
    margin: var(--space-lg) auto 0;
    padding: 0;
    list-style: none;
  }

  .art-card {
    aspect-ratio: 3 / 2;
    min-width: 0;
    overflow: hidden;
    border: var(--border-thin) solid var(--color-bg);
  }

  .art-card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .work-tease {
    display: grid;
    gap: var(--space-xl);
    align-items: start;
    padding: var(--space-md) var(--space-edge) var(--space-lg);
    color: var(--color-text);
    background: var(--color-bg);
  }

  .work-tease__label {
    margin: 0;
    padding: var(--space-md) var(--space-md) var(--space-md) 0;
    color: var(--color-hero-name);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    background: var(--color-bg);
  }

  .work-tease__panel {
    position: relative;
    height: clamp(8rem, 16vw, 10.5rem);
    margin-top: var(--space-md);
    overflow: hidden;
  }

  .work-tease__panel img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right center;
    transition: transform var(--duration-standard) var(--ease-out);
  }

  .work-tease__panel span {
    position: absolute;
    top: var(--space-md);
    left: var(--space-md);
    color: var(--color-hero-name);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .work-tease__panel:hover img,
  .work-tease__panel:focus-visible img {
    transform: scale(1.02);
  }

  @media (min-width: 48rem) {
    /* oversize and pull left so the red wash reaches behind the preview row */
    .hero__watercolor {
      left: -15%;
      width: 115%;
    }

    .hero__work-previews {
      grid-template-columns: repeat(3, minmax(10rem, 20rem));
      width: auto;
      margin: var(--space-lg) 0 0;
    }

    .work-tease {
      grid-template-columns: minmax(11rem, 0.24fr) minmax(0, 1fr);
    }

    .work-tease__panel {
      width: auto;
      margin-right: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .work-tease__panel img {
      transition: none;
    }
  }
</style>
