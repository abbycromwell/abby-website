---
import Base from '../layouts/Base.astro';

const experience = [
  {
    org: 'Cromwell Works',
    role: 'Design Intern',
    dates: 'June 2026 – Present',
    note: 'Generalist designer working across illustration, motion and video, graphic design, UX, and web prototyping.',
  },
  {
    org: 'UCLA ACM',
    role: 'Design Officer',
    dates: 'August 2025 – Present',
    note: "Support ACM's internal and cross-organization projects by creating visual assets, maintaining design consistency, and collaborating with designers and developers across UCLA's largest computing community.",
  },
  {
    org: 'Adobe',
    role: 'Student Ambassador',
    dates: 'August 2025 – Present',
    note: 'Educate campus students about Adobe software as a student ambassador.',
  },
  {
    org: 'Palo Alto Art Center',
    role: 'Teaching Assistant',
    dates: 'July 2021 – September 2023',
    note: 'Assisted with classroom management, including preparing materials and helping participants with artwork.',
  },
];

const education = [
  {
    org: 'UCLA Design Media Arts',
    role: 'Sophomore',
    dates: 'September 2025 – Present',
    note: 'Courses taken: Video and Motion, Design Culture, Typography, American Film History, Digital Image, Media History, Digital Cultures and Societies.',
  },
  {
    org: 'Palo Alto High School',
    role: '',
    dates: 'August 2021 – June 2025',
    note: 'Advanced placement and honors classes including Chemistry H, Advanced Painting and Drawing H, AP Psychology, AP Environmental Science, AP Language and Composition, AP Art History, and AP Art and Design.',
  },
  {
    org: 'Summer and Pre-College Art Programs',
    role: '',
    dates: '2021 – June 2025',
    note: 'Huntington Fine Arts (portfolio development), CalArts Extended Studies (visual storytelling), School of Visual Arts Pre-College (animation), RISD Advanced Online Program (design exploration), California College of the Arts (figure drawing; comics and visual storytelling), SAIC Early College Program Summer Institute (figure drawing, merit scholarship), and The Oxbow Art School (honors studio arts).',
  },
];

const awards = [
  { title: 'Scholastic Art and Writing, 2025', detail: '4 Gold Keys, 1 Silver Key, 3 Honorable Mentions' },
  { title: 'Scholastic Art and Writing, 2024', detail: '1 Gold Key, 1 Honorable Mention' },
];

const exhibitions = [
  { title: 'Youth Art Exhibition, 2024', detail: 'Untitled (watercolor)' },
  { title: 'Changing the Narrative juried international exhibition, 2024', detail: 'The Setting (encaustic monotype)' },
  { title: 'Huntington Fine Arts, 2023–2024', detail: 'Various pieces' },
];

const design = [
  'Brand Design, Illustration, Character Design',
  'Animation, AI Native Design, Game Design',
];

const software = [
  'Figma, Procreate, Procreate Dreams',
  'Adobe Animate, Illustrator, Photoshop, After Effects',
  'Codex, Claude, Vercel',
];
---

<Base
  title="Resume — Abby Cromwell"
  description="Resume of Abby Cromwell, Design Media Arts student at UCLA."
  atmospheric
  ground="field"
>
  <div class="resume-page">
    <section class="resume" aria-labelledby="resume-title">
      {/*
        The page opens straight onto the content, so the heading stays clipped
        for AT. The printed sheet has no site header to carry the name, so the
        same h1 unclips in print and swaps its text: one heading, two voices,
        and no second h1 competing with it in the outline.
      */}
      <h1 id="resume-title" class="sr-only resume__masthead">
        <span class="screen-only">Resume</span>
        <span class="print-only" aria-hidden="true">Abby Cromwell</span>
      </h1>

      <div class="resume__grid">
        <div class="resume__main">
          <section class="resume-section" aria-labelledby="experience-title">
            <h2 class="eyebrow" id="experience-title">Experience</h2>
            {experience.map((entry) => (
              <article class="resume-entry">
                <h3>{entry.org}</h3>
                <p class="resume-entry__meta">
                  {entry.role && <span>{entry.role}</span>}
                  <span>{entry.dates}</span>
                </p>
                {entry.note && <p class="resume-entry__note">{entry.note}</p>}
              </article>
            ))}
          </section>

          <section class="resume-section" aria-labelledby="education-title">
            <h2 class="eyebrow" id="education-title">Education</h2>
            {education.map((entry) => (
              <article class="resume-entry">
                <h3>{entry.org}</h3>
                <p class="resume-entry__meta">
                  {entry.role && <span>{entry.role}</span>}
                  <span>{entry.dates}</span>
                </p>
                {entry.note && <p class="resume-entry__note">{entry.note}</p>}
              </article>
            ))}
          </section>

        </div>

        <aside class="resume__side">
          {/* the same detail rows SongBook and About carry */}
          <dl class="resume-details">
            <div>
              <dt class="eyebrow">Contact</dt>
              {/*
                Screen keeps the obfuscated address; paper gets the real one, so
                it can be read off a printed sheet and typed. The print rows are
                display:none on screen, so AT never reaches them, and aria-hidden
                says so a second time rather than relying on that alone.
              */}
              <dd class="screen-only"><a class="text-link" href="mailto:abbycromwell@ucla.edu">abbycromwell at ucla dot edu</a></dd>
              <dd class="print-only" aria-hidden="true"><a class="text-link text-link--plain" href="mailto:abbycromwell@ucla.edu">abbycromwell@ucla.edu</a></dd>
              <dd class="print-only" aria-hidden="true"><a class="text-link text-link--plain" href="https://abbycromwell.com">abbycromwell.com</a></dd>
            </div>
            {/* the printed resume IS this PDF; the row drops out of the export */}
            <div class="resume-details__download">
              <dt class="eyebrow">Resume</dt>
              <dd><a class="text-link" href="/abby-cromwell-resume.pdf">Download the PDF <span aria-hidden="true">→</span></a></dd>
            </div>
            <div>
              <dt class="eyebrow">LinkedIn</dt>
              <dd><a class="text-link" href="https://www.linkedin.com/in/abbycromwell/" rel="me">abbycromwell <span aria-hidden="true">→</span></a></dd>
            </div>
          </dl>

          <section class="resume-section" aria-labelledby="design-title">
            <h2 class="eyebrow" id="design-title">Design</h2>
            <ul class="resume-list">
              {design.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>

          <section class="resume-section" aria-labelledby="software-title">
            <h2 class="eyebrow" id="software-title">Tools</h2>
            <ul class="resume-list">
              {software.map((item) => <li>{item}</li>)}
            </ul>
          </section>

          <section class="resume-section" aria-labelledby="awards-title">
            <h2 class="eyebrow" id="awards-title">Awards &amp; Scholarships</h2>
            <ul class="resume-list resume-list--detailed">
              {awards.map((item) => (
                <li>
                  <span class="resume-list__title">{item.title}</span>
                  {item.detail && <span class="resume-list__detail">{item.detail}</span>}
                </li>
              ))}
            </ul>
          </section>

          <section class="resume-section" aria-labelledby="exhibitions-title">
            <h2 class="eyebrow" id="exhibitions-title">Exhibitions</h2>
            <ul class="resume-list resume-list--detailed">
              {exhibitions.map((item) => (
                <li>
                  <span class="resume-list__title">{item.title}</span>
                  <span class="resume-list__detail">{item.detail}</span>
                </li>
              ))}
            </ul>
          </section>

        </aside>
      </div>

    </section>
  </div>
</Base>

<style>
  .resume {
    max-width: var(--max-width-wide);
    margin-inline: auto;
    /* the hero is gone; page-top padding left a dead half-screen above the grid */
    padding: var(--space-2xl) var(--space-edge) var(--space-section);
  }

  h1 {
    margin-bottom: var(--space-xl);
    font-size: var(--text-display);
    font-weight: var(--weight-light);
    line-height: var(--leading-hero);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }




  .resume__grid {
    display: grid;
    gap: var(--space-2xl);
    /* the section's own padding is the beat; --space-section on top of it was a
       dead half-screen once the hero came out */
    margin-top: 0;
  }

  .resume__main,
  .resume__side {
    display: grid;
    gap: var(--space-2xl);
    align-content: start;
  }

  /*
    No wash card. The Paper Wash panel read as nothing on this ground but its
    24px padding silently knocked the whole sidebar out of alignment with the
    main column's rules and labels.
  */
  .resume__side {
    gap: var(--space-xl);
  }

  .resume-section {
    display: grid;
    gap: var(--space-lg);
  }

  .resume-section .eyebrow {
    margin-bottom: 0;
  }

  .resume-entry {
    border-top: var(--border-thin) solid var(--color-border);
    padding-top: var(--space-md);
  }

  .resume-entry h3 {
    margin-bottom: var(--space-2xs);
    font-size: var(--text-lg);
    font-weight: var(--weight-medium);
  }

  .resume-entry__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-md);
    margin-bottom: var(--space-sm);
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .resume-entry__note {
    max-width: var(--max-width-prose);
    margin-bottom: 0;
    color: var(--color-text-secondary);
  }

  .resume-list {
    display: grid;
    gap: var(--space-sm);
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: var(--border-thin) solid var(--color-border);
    padding-top: var(--space-md);
    color: var(--color-text-secondary);
  }

  .resume-list--detailed {
    gap: var(--space-md);
  }

  .resume-list--detailed li {
    display: grid;
    gap: var(--space-2xs);
  }

  .resume-list__title {
    color: var(--color-text);
    font-weight: var(--weight-medium);
  }



  @media (min-width: 48rem) {
    .resume__grid {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      column-gap: var(--space-2xl);
    }
  }
  /* the sidebar's own grid gap is the beat; a margin here doubled it */
  .resume-details {
    margin: 0;
  }

  .resume-details > div {
    padding-block: 0 var(--space-md);
  }

  /* label first, hairline under it — the idiom every section on this page uses */
  .resume-details dt {
    margin-bottom: var(--space-sm);
    padding-bottom: var(--space-2xs);
    border-bottom: var(--border-thin) solid var(--color-border);
  }

  .resume-details dd {
    margin: 0;
    font-size: var(--text-base);
    line-height: var(--leading-normal);
  }

  /* the two media get different words in the same slots; neither ever sees both */
  .print-only {
    display: none;
  }

  /*
    Print overrides for this page's own selectors live in the scoped block, not
    the global one below: Astro emits the global block ahead of the token
    stylesheet link, so a bare `.resume` there loses to the scoped rules above
    on both specificity and order. Scoped, they land.
  */
  @media print {
    .print-only {
      display: revert;
    }

    .screen-only {
      display: none;
    }

    /*
      The h1 is .sr-only on screen, so it unclips here rather than a second h1
      being introduced. Sized off --text-xl: --text-display is a 9vw clamp that
      lands at ~73px on an 816px sheet, which would eat a third of the page.
    */
    .resume__masthead {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip-path: none;
      white-space: normal;
      margin-bottom: var(--space-lg);
      font-size: var(--text-xl);
      line-height: var(--leading-tight);
    }

    /* an address is not a label: it reads as written, not shouted in caps */
    .text-link--plain {
      font-size: var(--text-sm);
      letter-spacing: normal;
      text-transform: none;
    }

    /* @page margin is 0 for full bleed, so the sheet's margin is padding here */
    .resume {
      max-width: none;
      padding: 0.5in 0.5in 0.4in;
    }

    .resume__grid {
      margin-top: 0;
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      column-gap: var(--space-xl);
    }

    .resume__main,
    .resume__side {
      gap: var(--space-xl);
    }

    /* the note's screen measure is narrower than the printed main column */
    .resume-entry__note {
      max-width: none;
    }

    /* a PDF should not offer a link to downloading itself */
    .resume-details__download {
      display: none;
    }

    .resume-entry,
    .resume-list li,
    .resume-details > div {
      break-inside: avoid;
      page-break-inside: avoid;
    }
  }
</style>

<style is:global>
  /* Print / PDF export: the page's own paper and wash, edge to edge, no site
     chrome, two columns forced (print width sits below the 48rem breakpoint). */
  @media print {
    @page {
      size: letter;
      /* full bleed: the sheet's margin lives on .resume so the paper colour and
         the wash run to the trim edge instead of stopping at a white border */
      margin: 0;
    }

    * {
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }

    /*
      Print type is a step down from screen: the sheet is 816px wide where the
      layout was drawn for a desktop viewport, so the screen ramp reads oversized
      on paper. Overriding the tokens keeps every rule on var(--*).
      `html:root` rather than `:root`: this block is emitted ahead of the token
      stylesheet, so a matching-specificity `:root` would lose on order.
    */
    html:root {
      --text-xs: 0.62rem;
      --text-sm: 0.7rem;
      --text-base: 0.8rem;
      --text-lg: 0.98rem;

      --space-2xs: 3px;
      --space-xs: 5px;
      --space-sm: 8px;
      --space-md: 10px;
      --space-lg: 14px;
      --space-xl: 22px;
      --space-2xl: 28px;
    }

    html,
    body {
      background: var(--color-bg) !important;
    }

    .site-header,
    .skip-link {
      display: none !important;
    }

    /*
      The wash is the page's ground, so it prints. Fixed, not absolute: an
      absolute plate ends at the document height and leaves the tail of the last
      sheet on bare paper, where a fixed one repaints per sheet.
    */
    .site-watercolor,
    .site-watercolor--field {
      display: block !important;
      position: fixed !important;
      inset: 0 !important;
      width: 100% !important;
      height: 100% !important;
      min-height: 0 !important;
      object-fit: cover !important;
      object-position: center top !important;
      opacity: 0.3 !important;
    }

    /* the arrow is a hover affordance; on paper it is a stray glyph */
    .text-link span {
      display: none !important;
    }

    .text-link {
      padding-bottom: 0 !important;
    }
  }
</style>
