---
import { Image } from 'astro:assets';

interface Props {
  /* Visible section heading. */
  heading?: string;
  /* Optional id for the section, for anchor links. */
  id?: string;
}

/*
  `bare` drops the component's own dark ground and vertical padding, for hosts
  that already provide a ground — the Work page gallery carries a painted wash a
  solid band would cut straight through.
*/
const { heading = 'Read the book', id, bare = false, hideHeading = false } = Astro.props;
const headingId = `${id ?? 'songbook'}-heading`;

/*
  The 24 book spreads, in the PDF's export order: cover, contents, essay,
  review, discography, black & white studies, color & image studies,
  animation stills, colophon.
*/
const spreadImages = import.meta.glob('../assets/case-study/spread-*.webp', {
  import: 'default',
  eager: true,
});

const spreadAlts = [
  'Cover: coral watercolor streaks with the song title m@HΦu 少女 in red display letters',
  'Contents spread listing editorial, black and white, color and image, and animation chapters',
  'Song essay spread: why the song was chosen and why it is set in Futura',
  'Album review spread for Mariko Goto’s 299792458 with a portrait and a red cityscape illustration',
  'Goto-san in Midori: live photo and an annotated Midori discography',
  'Black and white studies 1 to 4: stacked text-block grids and tiny centered settings',
  'Black and white studies 5 to 8: a figure built from repeated type, scattered numerals, circular flows',
  'Black and white studies 9 to 12: dense glyph fields and faint letterpress-like settings',
  'Black and white studies 13 to 16: pattern fields, mirrored settings, and thread-like arcs of type',
  'Black and white studies 17 to 20: octopus of dotted type, umbrella arcs, a monumental 女 character',
  'Inspirations spread on Shūzō Oshimi’s Flowers of Evil with anime stills and a quote on puberty',
  'Black and white study 24: skewed collage of white-on-black type blocks',
  'Black and white study 23: barcode setting of 299792458 under vertical rules',
  'Black and white study 22: tumbling black-and-white cards with mariko goto labels',
  'Black and white study 21: 少女 characters over a black-and-white tile pattern',
  'Color studies 25 and 26: chromatic type debris on dark red, white glyphs raining on sky blue',
  'Color studies 27 and 28: red DOKI lyric poster and layered gray glyph field',
  'Color study 29: photo cover of a figure in tall grass holding a red tentacle, wrapped in type',
  'Color study 30: night street photo montage with thin white display type on black',
  'Color study 31: illustrated cover of a crouching figure with ants, title in red',
  'Color study 32: blue city montage cover with DOKI type and tangled cables',
  'Animation stills: nine frames of lyric type flashing over live concert footage',
  'Animation stills: eighteen frames in black, blue, and red framings',
  'Colophon: typeset in Futura PT, text paper Neenah Royal Sundance brilliant white',
];

const spreads = Object.keys(spreadImages)
  .sort()
  .map((path, i) => ({ src: spreadImages[path], alt: spreadAlts[i] ?? 'SongBook spread' }));
---

<section class:list={['case-reader', { 'case-reader--bare': bare }]} data-songbook id={id} aria-labelledby={headingId}>
  <div class="case-reader__rule">
    <h2 id={headingId} class:list={{ 'sr-only': hideHeading }}>{heading}</h2>
    <div class="case-reader__controls">
      <button type="button" data-book-prev aria-label="Previous spread">
        <span aria-hidden="true">←</span> Prev
      </button>
      <p aria-live="polite">
        <span data-spread-count>1</span> / {spreads.length}
        <span class="case-reader__sr" data-spread-alt></span>
      </p>
      <button type="button" data-book-next aria-label="Next spread">
        Next <span aria-hidden="true">→</span>
      </button>
    </div>
  </div>
  <div class="case-reader__stage">
    <div
      class="book"
      data-book
      tabindex="0"
      role="region"
      aria-roledescription="book"
      aria-label="SongBook spreads. Use the arrow keys to turn pages."
    >
      <ul>
        {spreads.map((spread, i) => (
          <li>
            <Image
              src={spread.src}
              alt={spread.alt}
              widths={[768, 1152, 2040]}
              sizes="(min-width: 48rem) 88vw, 95vw"
              loading={i < 3 ? 'eager' : 'lazy'}
            />
          </li>
        ))}
      </ul>
      <div class="book__leaf" data-leaf hidden>
        <div class="book__face book__face--front"></div>
        <div class="book__face book__face--back"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .case-reader {
    padding-block: var(--space-xl) var(--space-section);
    color: var(--color-text-on-dark);
    background: var(--color-bg-dark);
  }

  .case-reader--bare {
    padding-block: 0;
    background: none;
  }

  /*
    With the heading hidden the controls were the only in-flow child, so
    space-between parked them on the left. flex-end keeps them right whether the
    heading shows or not.
  */
  .case-reader__rule {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: flex-end;
    gap: var(--space-2xs) var(--space-lg);
    gap: var(--space-2xs) var(--space-lg);
    max-width: var(--max-width-wide);
    margin-inline: auto;
    margin-bottom: var(--space-lg);
    padding-inline: var(--space-edge);
  }

  .case-reader__rule h2:not(.sr-only) {
    margin-right: auto;
  }

  .case-reader__rule h2 {
    margin-bottom: 0;
    color: var(--color-text-on-dark);
    font-size: var(--text-xl);
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
  }

  .case-reader__controls {
    display: flex;
    align-items: baseline;
    gap: var(--space-lg);
  }

  .case-reader__controls p {
    margin: 0;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
  }

  .case-reader__controls button {
    min-height: 44px;
    padding: var(--space-xs) var(--space-sm);
    border: 0;
    background: none;
    color: var(--color-text-on-dark);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    cursor: pointer;
    transition:
      color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .case-reader__controls button:hover,
  .case-reader__controls button:focus-visible {
    color: var(--color-accent);
  }

  /*
    You press these two dozen times to read the book, so the press has to answer.
    Kept near-imperceptible for that frequency: 3%, and gone in 150ms.
  */
  .case-reader__controls button:active:not(:disabled) {
    transform: scale(0.97);
  }

  .case-reader__controls button:focus-visible {
    outline: var(--border-thin) solid currentColor;
    outline-offset: var(--space-2xs);
  }

  .case-reader__controls button[disabled] {
    opacity: 0.4;
    cursor: default;
  }

  .case-reader__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .case-reader__stage {
    max-width: var(--max-width-wide);
    margin-inline: auto;
    padding-inline: var(--space-edge);
  }

  /*
    The book. Without JS the spreads stack vertically; with JS the list is
    hidden and the page-flip surface takes over. The fallback is the source of
    truth — the half-pages are built from these very <img>s at runtime, so the
    two can never describe different books.
  */
  .book {
    position: relative;
  }

  .book:focus-visible {
    outline: var(--border-thin) solid var(--color-accent);
    outline-offset: var(--space-2xs);
  }

  /*
    Explicit, because `display: grid` below outranks the UA's own
    `[hidden] { display: none }` — author declarations win over the UA sheet
    whatever the specificity. Without this the fallback stack stays on screen
    under the book: 24 spreads, roughly 7700px of it.
  */
  .book ul[hidden] {
    display: none;
  }

  .book ul {
    display: grid;
    gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .book img {
    display: block;
    width: 100%;
    height: auto;
  }

  /*
    Everything below is :global and scoped under .book by hand. The pages and
    their images are built in the script, so they never carry Astro's scoping
    attribute and a plain `.book__page` selector matches nothing at all — the
    page keeps `overflow: visible` and the image stays `static`, which reads as
    both halves showing the same uncropped crop.
  */

  /*
    The turning surface. StPageFlip positions and sizes the pages itself, so it
    only needs a box to live in; everything below is the paper, not the hinge.
  */
  /*
    The book is clipped to its own footprint. A turning page is positioned in 3D
    and its projection reaches well outside the block — during a corner peel or
    a soft turn whole pages were landing on the title underneath. In this
    projection a page's arc never needs to leave the spread, so the clip costs
    nothing and is the only thing that reliably contains it.
  */
  .book :global(.book__pages) {
    margin-inline: auto;
    overflow: hidden;
  }

  /*
    No `position` here on purpose. The stylesheet imported by the script sets
    `.stf__item { position: absolute }`, which is both what keeps a turning page
    out of normal flow and what makes each page the containing block for the
    half-spread image inside it. Declaring `relative` here outranks that and
    puts the pages back in flow.
  */
  .book :global(.book__page) {
    overflow: hidden;
    background: var(--color-bg);
  }

  /*
    Each source file is a whole two-page spread, so a page shows half of one:
    the image is laid in at double width and slid left by its own width for the
    recto. The back of a verso is the next spread's recto, which is what a real
    book does and what a single hinged leaf could not express.
  */
  .book :global(.book__page img) {
    position: absolute;
    top: 0;
    width: 200%;
    max-width: none;
    height: 100%;
    user-select: none;
  }

  .book :global(.book__page--left img) {
    left: 0;
  }

  .book :global(.book__page--right img) {
    left: -100%;
  }

  /* the library paints the fold and the lift; the border is the book's edge */
  .book :global(.book__page--left) {
    border-left: var(--border-thin) solid var(--color-border);
  }

  .book :global(.book__page--right) {
    border-right: var(--border-thin) solid var(--color-border);
  }

</style>

<script>
  import { PageFlip } from 'page-flip/dist/js/page-flip.module.js';
  /*
    Required, not optional. It carries `.stf__item { position: absolute }`, and
    without it every turning page falls into normal flow and hangs below the
    book — up to 476px of it, over the title underneath.
  */
  import 'page-flip/src/Style/stPageFlip.css';

  /*
    Each source image is a complete spread, so it is cut into a verso and a recto
    and the book is twice as many pages as there are files. The halves are built
    from the no-JS list rather than rendered twice on the server: same <img>, same
    srcset Astro generated for it, no second copy of the book in the HTML.
  */
  for (const reader of document.querySelectorAll('[data-songbook]')) {
    const book = reader.querySelector('[data-book]');
    const list = book?.querySelector('ul');
    const spreads = list ? [...list.querySelectorAll('img')] : [];
    if (!book || spreads.length < 2) continue;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const holder = document.createElement('div');
    holder.className = 'book__pages';
    /* held by reference: loadFromHTML moves these out of holder into its own block */
    const pages = [];

    spreads.forEach((source, i) => {
      for (const side of ['left', 'right']) {
        /*
          Every page soft, including the first and last. Marking those `hard`
          made them flip rigidly, and the opening turn stopped matching every
          other turn in the book. A hard page models board; these spreads are
          printed on the same stock as the rest, and the cover here is a designed
          spread rather than a physical case.
        */
        const page = document.createElement('div');
        page.className = `book__page book__page--${side}`;

        const half = document.createElement('img');
        half.src = source.currentSrc || source.src;
        if (source.srcset) half.srcset = source.srcset;
        if (source.sizes) half.sizes = source.sizes;
        /*
          The alt describes the whole spread, so it belongs to the verso only.
          On the recto it would be read a second time for the same picture.
        */
        half.alt = side === 'left' ? source.alt : '';
        half.loading = i < 2 ? 'eager' : 'lazy';
        half.draggable = false;
        page.append(half);
        holder.append(page);
        pages.push(page);
      }
    });

    book.append(holder);
    list.hidden = true;

    const flip = new PageFlip(holder, {
      width: 1020,
      height: 720,
      size: 'stretch',
      /*
        Per page, and they hold the 1020:720 ratio so the floor cannot squash a
        spread. 240 was too high: two of them plus the fold made a 480px book on
        a 390px phone, which overflowed the screen sideways.
      */
      minWidth: 90,
      maxWidth: 1600,
      minHeight: 64,
      maxHeight: 1130,
      /* the lighting that was missing: a lifting page darkens and casts */
      drawShadow: !reduced.matches,
      maxShadowOpacity: 0.5,
      /*
        Not the felt duration. The library derives that from pixel distance,
        `(travel / 1000) * flippingTime`, and a turn crosses the whole book. On
        an 829px book that lands near 580ms, which is the beat we want. The same
        arithmetic is why the corner hint has to borrow a slower setting: it
        travels 50px, so on this one it would be over in 35ms.
      */
      flippingTime: reduced.matches ? 1 : 700,
      /*
        Never. A page here is half of a composition that was laid out across the
        fold, so showing one alone shows half a picture. Portrait mode is right
        for a book of single pages; this is a book of spreads, and it scales the
        whole spread down instead.
      */
      usePortrait: false,
      /* the corner lifts under the pointer, which is the affordance to grab it */
      showPageCorners: !reduced.matches,
      mobileScrollSupport: true,
      showCover: false,
    });

    flip.loadFromHTML(holder.querySelectorAll('.book__page'));

    /* a no-op unless the hint is running, so the turn paths need no branch */
    let releaseBeforeTurn = (turn) => turn();

    const prev = reader.querySelector('[data-book-prev]');
    const next = reader.querySelector('[data-book-next]');
    const countOut = reader.querySelector('[data-spread-count]');
    const altOut = reader.querySelector('[data-spread-alt]');

    /* the reader counts spreads; the library counts pages, two to a spread */
    const sync = () => {
      const spread = Math.floor(flip.getCurrentPageIndex() / 2);
      if (countOut) countOut.textContent = String(spread + 1);
      if (altOut) altOut.textContent = spreads[spread]?.alt ?? '';
      if (prev) prev.disabled = spread === 0;
      if (next) next.disabled = spread >= spreads.length - 1;

      /*
        Warm the neighbours. The halves are lazy and the library keeps every page
        but the current spread hidden, so a turn could reveal one with its file
        still on the wire. Switching the attribute starts the fetch, and both
        halves of a spread share a file, so it costs one request each way.
      */
      for (const offset of [-1, 1]) {
        const at = spread + offset;
        if (at < 0 || at >= spreads.length) continue;
        for (const page of [pages[at * 2], pages[at * 2 + 1]]) {
          const half = page?.firstElementChild;
          if (half) half.loading = 'eager';
        }
      }
    };

    flip.on('flip', sync);
    sync();

    /*
      One corner lift when the book arrives, so it reads as something you turn
      rather than a picture of a book. Deliberately not a flip: a page that
      turns itself has read the first spread on the visitor's behalf and moved
      them off it. This is the library's own peel, the same gesture the pointer
      makes, run once and released.

      Coordinates are relative to the book, which is what showCorner expects,
      and the corner has to be inside its hit zone or the call is ignored.
    */
    if (!reduced.matches) {
      const baseFlippingTime = flip.getSettings().flippingTime;
      let pending = [];
      /*
        No timer takes the fold back down. A dwell long enough to be certain of
        being seen is also long enough to look stuck, and a shorter one can be
        missed entirely — so it holds until the visitor does something, which is
        the moment it has stopped being useful. It is released rather than left
        folded for good: the corner sits over the bottom of the artwork, and the
        library treats a folded corner as a state it is passing through.
      */
      let dismissed = false;
      let hintObserver = null;

      /*
        `smooth` for a pointer arriving, which is a change of mind and can take
        its time; instant for a turn, which is not. The library refuses to start
        a flip while a corner is folded, so a leisurely release would swallow the
        visitor's first click entirely — restoring the shared duration before
        letting go puts the corner down in about 35ms and the turn follows.
      */
      const dismiss = (smooth) => {
        if (dismissed) return;
        dismissed = true;
        /* it can no longer do anything useful, and it outlives the page otherwise */
        hintObserver?.disconnect();
        for (const id of pending) clearTimeout(id);
        pending = [];
        if (!smooth) flip.getSettings().flippingTime = baseFlippingTime;
        if (flip.getState() === 'fold_corner') flip.getFlipController().stopMove();
        if (smooth) {
          setTimeout(() => {
            flip.getSettings().flippingTime = baseFlippingTime;
          }, 400);
        }
      };

      /* the corner is down before the turn starts, so the turn is never lost */
      releaseBeforeTurn = (turn) => {
        if (dismissed) return turn();
        dismiss(false);
        setTimeout(turn, 60);
      };

      book.addEventListener('pointerenter', () => dismiss(true), { once: true, passive: true });

      /*
        The book has to settle in the viewport before the corner moves. Firing on
        the intersection itself puts the lift under a page that is still
        travelling, where it is both hard to see and easy to mistake for the
        scroll; and someone flicking straight past should not spend the hint at
        all. So arriving only starts a clock, leaving stops it, and the corner
        lifts a second after the book has actually come to rest on screen.
      */
      const SETTLE = 1000;
      let settling = null;

      hintObserver = new IntersectionObserver(
        (entries, observer) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) {
              clearTimeout(settling);
              settling = null;
              continue;
            }
            if (settling !== null || dismissed) continue;

            settling = setTimeout(() => {
              observer.disconnect();
              if (dismissed || flip.getState() !== 'read') return;
              /*
                The hint travels 50px, so on the shared setting it would lift and
                drop in under a tenth of a second and read as a glitch. The
                settings object is live, so it borrows a much slower one and
                hands it back — a pointer peel should still answer immediately.
              */
              flip.getSettings().flippingTime = 6400;
              const rect = flip.getBoundsRect();
              flip.getFlipController().showCorner({ x: rect.width - 1, y: rect.height - 1 });
            }, SETTLE);
            pending.push(settling);
          }
        },
        { threshold: 0.5 },
      );
      hintObserver.observe(holder);
    }

    prev?.addEventListener('click', () => releaseBeforeTurn(() => flip.flipPrev()));
    next?.addEventListener('click', () => releaseBeforeTurn(() => flip.flipNext()));

    book.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') { event.preventDefault(); releaseBeforeTurn(() => flip.flipNext()); }
      if (event.key === 'ArrowLeft') { event.preventDefault(); releaseBeforeTurn(() => flip.flipPrev()); }
    });
  }
</script>
