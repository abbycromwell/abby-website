---
import { Image } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/global.css';
import heroWatercolor from '../assets/home/hero-watercolor-veins.png';
import veinFieldPaper from '../assets/home/vein-field-paper.png';

const {
  title = 'Abby Cromwell — Portfolio',
  description = 'Illustrative art, character design, and storytelling by Abby Cromwell.',
  immersive = false,
  atmospheric = false,
  ground = 'veins',
  activePage = '',
} = Astro.props;

/* Which watercolor plate the atmospheric background renders. Named `ground`
   because `plate` already means a framed artwork on the Work page. */
const grounds = {
  veins: heroWatercolor,
  field: veinFieldPaper,
};
const groundName = ground in grounds ? ground : 'veins';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class:list={{ 'body--atmospheric': atmospheric }}>
    {atmospheric && (
      <Image
        class:list={['site-watercolor', `site-watercolor--${groundName}`]}
        src={grounds[groundName]}
        alt=""
        aria-hidden="true"
        loading="eager"
        widths={[768, 1152, 1536]}
        sizes="100vw"
      />
    )}
    <a class="skip-link" href="#main">Skip to content</a>
    <header class:list={['site-header', { 'site-header--overlay': immersive }]}>
      <nav class="site-nav" aria-label="Main">
        {!immersive && <a href="/" class="nav-name">Abby Cromwell</a>}
        <ul class="nav-links">
          <li><a href="/work/" aria-current={activePage === 'work' ? 'page' : undefined}>Work</a></li>
          <li><a href="/songbook/" aria-current={activePage === 'songbook' ? 'page' : undefined}>SongBook</a></li>
          <li><a href="/about/" aria-current={activePage === 'about' ? 'page' : undefined}>About</a></li>
        </ul>
      </nav>
    </header>
    <main id="main" class:list={['page', { 'page--immersive': immersive }]}>
      <slot />
    </main>
  </body>
</html>
