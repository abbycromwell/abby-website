---
import { Image } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/global.css';
import heroWatercolor from '../assets/home/hero-watercolor-veins.png';

const {
  title = 'Abby Cromwell — Portfolio',
  description = 'Illustrative art, character design, and storytelling by Abby Cromwell.',
  immersive = false,
  atmospheric = false,
  activePage = '',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class:list={{ 'body--atmospheric': atmospheric }}>
    {atmospheric && (
      <Image
        class="site-watercolor"
        src={heroWatercolor}
        alt=""
        aria-hidden="true"
        loading="eager"
        widths={[768, 1152, 1536]}
        sizes="100vw"
      />
    )}
    <a class="skip-link" href="#main">Skip to content</a>
    <header class:list={['site-header', { 'site-header--overlay': immersive }]}>
      <nav class="site-nav" aria-label="Main">
        <a href="/" class="nav-name">Abby Cromwell</a>
        <ul class="nav-links">
          <li><a href="/work/" aria-current={activePage === 'work' ? 'page' : undefined}>Work</a></li>
          <li><a href="/about/" aria-current={activePage === 'about' ? 'page' : undefined}>About</a></li>
          <li><a href="mailto:abbycromwell@ucla.edu">Email</a></li>
        </ul>
      </nav>
    </header>
    <main id="main" class:list={['page', { 'page--immersive': immersive }]}>
      <slot />
    </main>
  </body>
</html>
