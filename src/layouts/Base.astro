---
import { Image } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/global.css';
import heroWatercolor from '../assets/home/hero-watercolor-veins.png';
import veinFieldPaper from '../assets/home/vein-field-paper.png';

const {
  title = 'Abby Cromwell — Portfolio',
  description = 'Illustrative art, character design, and storytelling by Abby Cromwell.',
  immersive = false,
  atmospheric = false,
  ground = 'veins',
  activePage = '',
} = Astro.props;

/* Which watercolor plate the atmospheric background renders. Named `ground`
   because `plate` already means a framed artwork on the Work page. */
const grounds = {
  veins: heroWatercolor,
  field: veinFieldPaper,
};
const groundName = ground in grounds ? ground : 'veins';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/*
      The mark is Abby's initial: the Jost A, taken as an outline from the same
      woff2 the masthead is set in, knocked out of a Name Red disc.

      Two artworks, because the platforms want different things. The tab icon keeps
      transparent corners so it reads as a disc. The touch and manifest icons carry
      paper corners instead, because iOS and Android composite a transparent icon
      onto black, which would sit the warm palette on a cold ground.

      SVG first for browsers that take it, .ico behind it for those that do not.
    */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {/*
      The @font-face rules live in global.css, which is inlined into this
      document, so the font is discoverable the moment the head is parsed. The
      preload starts the download before the parser even reaches the style block.
      crossorigin is not optional here: fonts are fetched in CORS mode even
      same-origin, and without it the browser preloads the file into a cache
      entry the @font-face request cannot use, and fetches it twice.
    */}
    <link
      rel="preload"
      href="/fonts/jost-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body class:list={{ 'body--atmospheric': atmospheric }}>
    {atmospheric && (
      <Image
        class:list={['site-watercolor', `site-watercolor--${groundName}`]}
        src={grounds[groundName]}
        alt=""
        aria-hidden="true"
        loading="eager"
        widths={[768, 1152, 1536]}
        sizes="100vw"
      />
    )}
    <a class="skip-link" href="#main">Skip to content</a>
    <header class:list={['site-header', { 'site-header--overlay': immersive }]}>
      <nav class="site-nav" aria-label="Main">
        {!immersive && <a href="/" class="nav-name">Abby Cromwell</a>}
        <ul class="nav-links">
          <li><a href="/work/" aria-current={activePage === 'work' ? 'page' : undefined}>Work</a></li>
          <li><a href="/songbook/" aria-current={activePage === 'songbook' ? 'page' : undefined}>SongBook</a></li>
          <li><a href="/about/" aria-current={activePage === 'about' ? 'page' : undefined}>About</a></li>
          {/*
            Last, and in the nav at all, because the audience is hiring teams: the
            resume is a primary artifact for them, and it was reachable only by
            going to About first and finding it in a detail row.
          */}
          <li><a href="/resume/" aria-current={activePage === 'resume' ? 'page' : undefined}>Resume</a></li>
        </ul>
      </nav>
    </header>
    {/*
      tabindex="-1" is what makes the skip link actually skip. <main> is not
      focusable on its own, so activating the link scrolled the viewport but left
      focus back at the top of the document — the next Tab returned the visitor to
      the nav they had just asked to bypass. -1 keeps it off the tab sequence.
    */}
    <main id="main" tabindex="-1" class:list={['page', { 'page--immersive': immersive }]}>
      <slot />
    </main>
  </body>
</html>
